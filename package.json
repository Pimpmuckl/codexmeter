{
  "name": "codexmeter",
  "version": "1.0.25",
  "description": "Local telemetry dashboard for Codex CLI usage",
  "type": "module",
  "bin": {
    "codexmeter": "bin/codexmeter.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "bin",
    "server",
    "src/utils/animationsDefault.js",
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "node dev-runner.js",
    "build": "vite build",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.js\" \"test/**/*.test.js\"",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "start": "node bin/codexmeter.js",
    "preview": "npm run build && node bin/codexmeter.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "ffmpeg-static": "^5.3.0",
    "open": "^11.0.0",
    "playwright-core": "^1.61.0"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "nodemon": "^3.1.14",
    "playwright": "^1.61.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.0.16"
  }
}
